[Unit]
Description=MacauJC Number Statistics Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/macaujc
ExecStart=/usr/bin/python3 app/server.py --host 0.0.0.0 --port 80 --db /opt/macaujc/data/macaujc.db
Restart=always
RestartSec=5
Environment=HOME=/opt/macaujc

[Install]
WantedBy=multi-user.target
